[sub_resource type="Shader" id="Shader_oho3u"]
code = "shader_type spatial;

render_mode diffuse_burley, cull_disabled, depth_prepass_alpha, shadows_disabled;

uniform float snap_amount = 240.0;

void vertex() {
	// Convert to clip space
	vec4 clip_pos = PROJECTION_MATRIX * MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
	
	clip_pos.xz = floor(clip_pos.xz * snap_amount) / snap_amount;
	
	POSITION = clip_pos;
}

"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_d3awe"]
render_priority = 0
shader = SubResource("Shader_oho3u")
shader_parameter/snap_amount = 40.0

[sub_resource type="BoxMesh" id="BoxMesh_oho3u"]
size = Vector3(5, 5, 1)

[sub_resource type="Shader" id="Shader_d3awe"]
code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_disabled,diffuse_burley,specular_schlick_ggx,unshaded;
uniform vec4 albedo : source_color = vec4(1.0, 1.0, 1.0, 0.0);


uniform float specular;


varying flat vec3 norm;
varying flat float norm_val;

uniform float offset = 0.05;

uniform float opacity = 0.9;


uniform sampler2D SCREEN_TEXTURE: hint_screen_texture,filter_linear_mipmap;

void vertex() {
	norm = NORMAL;
}










void fragment() {
	
	
	vec3 normx = NORMAL;
	NORMAL = norm;
	
	
	vec2 displacement = vec2(offset);
	displacement.x *= -normx.x*2.0;
	displacement.y *= -normx.y*2.0;
	vec4 alpha = vec4(1.0);
	alpha = texture(SCREEN_TEXTURE ,SCREEN_UV + displacement );
	
	
	
	
	
	
	ALBEDO = mix(alpha.rgb,albedo.rgb,albedo.a);
	SPECULAR = specular;
	ALPHA = opacity;
	
	
	
}
"

